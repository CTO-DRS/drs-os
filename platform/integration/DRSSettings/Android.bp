#
# DRS Settings — Soong integration template.
# STATUS: INACTIVE TEMPLATE — see platform/integration/README.md.
#
# IMPORTANT: this standalone APK demonstrates DRS settings policy UI.
# It is NOT the platform Settings replacement. Platform-level Settings
# integration is an overlay + entry-point injection task per
# docs/ui/native-system-surfaces.md surface #8.

android_app {
    name: "DRSSettings",
    pkgid: "com.drs.os.drssettings",

    srcs: [
        "app/src/main/kotlin/**/*.kt",
    ],
    // DRS-CORE-SOURCE: components/foundation + components/settings-core

    resource_dirs: ["app/src/main/res"],
    manifest: "app/src/main/AndroidManifest.xml",

    static_libs: [
        "androidx.core_core-ktx",
        "androidx.activity_activity-compose",
        "androidx.appcompat_appcompat",
        "androidx.compose.ui_ui",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.lifecycle_lifecycle-runtime-ktx",
    ],

    platform_apis: false,
    privileged: false,
    optimize: { enabled: false },
    min_sdk_version: "29",
    target_sdk_version: "35", // REVIEW at checkout (ADR-0001)
    sdk_version: "system_current",
}
